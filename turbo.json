{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "sync": {
      "cache": false,
      "outputs": [
        "src/harnesses.json"
      ]
    },
    "typecheck": {},
    "test": {},
    "build": {
      "dependsOn": [
        "^build",
        "^sync",
        "typecheck"
      ],
      "outputs": [
        "dist/**",
        "build/**"
      ]
    },
    "install-app": {
      "dependsOn": [
        "build"
      ],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "dev:host": {
      "cache": false,
      "persistent": true
    }
  }
}
